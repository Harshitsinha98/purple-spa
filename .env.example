# Copy to .env.local for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Public URL of the site (no trailing slash), e.g. https://purplespa.in
NEXT_PUBLIC_SITE_URL=

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The "secret" key (sb_secret_…). Server only — never expose it in the browser.
SUPABASE_SECRET_KEY=

# Razorpay → Account & Settings → API Keys (use rzp_test_… keys until KYC is done)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks → secret you chose when adding https://<site>/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

# Web push for staff/admin phones. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:purplespasalon23@gmail.com

# WhatsApp Cloud API (Meta for Developers → WhatsApp → API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANG=en
# Also message therapists on WhatsApp when assigned (uses the staff_new_booking template)
WHATSAPP_STAFF_ALERTS=false

# Random string; Vercel Cron sends it as a Bearer token to /api/cron/daily
CRON_SECRET=
